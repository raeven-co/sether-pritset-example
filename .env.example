# Pritset credentials — from the Portal (app.pritset.com)
# Profile page -> access token + secret; Templates page -> template ID.
#
# Either export these in your shell, or copy this file to .env and run:
#   npx tsx --env-file=.env src/run.ts
#
# Without these, the example still runs stages 1-3 and prints the request
# stage 4 would send.
PRITSET_ACCESS_TOKEN=
PRITSET_SECRET=
PRITSET_TEMPLATE_ID=
